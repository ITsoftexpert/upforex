      ],
      "translation": "<span data-i18n-slot=\"0\">关注最有可能影响期望的指标：</span>"
    },
    {
      "key": "tda7d49497b5070ab",
      "english": "<span data-i18n-slot=\"0\">3. Check the Volatility Environment</span>",
      "kind": "html",
