    },
    {
      "key": "ta02b0e5b7466133d",
      "english": "<span data-i18n-slot=\"0\">Current account value including open-position results</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-account-equity-in-trading#content",
        "SSR:/blogs/what-is-account-equity-in-trading"
      ],
      "translation": "<span data-i18n-slot=\"0\">当前账户价值，包括未平仓头寸结果</span>"
    },
    {
      "key": "t6aeb0e382de1c110",
