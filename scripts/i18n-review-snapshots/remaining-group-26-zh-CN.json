        "CMS:blogs/stop-loss-and-take-profit-risk-management-guide#content",
        "SSR:/blogs/stop-loss-and-take-profit-risk-management-guide"
      ],
      "translation": "<span data-i18n-slot=\"0\">对持仓不利的方向</span>"
    },
    {
      "key": "t14d82f4ec2eac5b8",
      "english": "<span data-i18n-slot=\"0\">Typical placement for a long trade</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/stop-loss-and-take-profit-risk-management-guide#content",
        "SSR:/blogs/stop-loss-and-take-profit-risk-management-guide"
      ],
      "translation": "<span data-i18n-slot=\"0\">多头交易的典型布局</span>"
    },
    {
      "key": "ta324d05c26161a0e",
      "english": "<span data-i18n-slot=\"0\">Below the entry price</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/stop-loss-and-take-profit-risk-management-guide#content",
        "SSR:/blogs/stop-loss-and-take-profit-risk-management-guide"
      ],
      "translation": "<span data-i18n-slot=\"0\">低于入场价</span>"
    },
    {
      "key": "tc99f11202029adc2",
      "english": "<span data-i18n-slot=\"0\">Above the entry price</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/stop-loss-and-take-profit-risk-management-guide#content",
        "SSR:/blogs/stop-loss-and-take-profit-risk-management-guide"
      ],
