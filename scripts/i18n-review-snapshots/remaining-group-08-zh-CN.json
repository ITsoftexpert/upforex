      ],
      "translation": "<span data-i18n-slot=\"0\">每点 1 美元</span>"
    },
    {
      "key": "t5c3952929f87ec28",
      "english": "<span data-i18n-slot=\"0\">$0.10 per pip</span>",
      "kind": "html",
      "sources": [
