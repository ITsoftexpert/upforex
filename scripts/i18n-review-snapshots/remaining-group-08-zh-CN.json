        "CMS:blogs/what-is-lot-size-in-forex#content",
        "SSR:/blogs/what-is-lot-size-in-forex"
      ],
      "translation": "<span data-i18n-slot=\"0\">每点 10 美元</span>"
    },
    {
      "key": "t745b9066d9ce3a56",
      "english": "<span data-i18n-slot=\"0\">0.10 Mini Lot</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
        "SSR:/blogs/what-is-lot-size-in-forex"
      ],
      "translation": "<span data-i18n-slot=\"0\">0.10 迷你手</span>"
    },
    {
      "key": "tc46048626feb79e6",
      "english": "<span data-i18n-slot=\"0\">$1 per pip</span>",
