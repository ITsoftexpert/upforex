    {
      "key": "t4e08b293bd0f5af1",
      "english": "<span data-i18n-slot=\"0\">A trader has decided to enter at the current market and does not require a retracement first.</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/market-order-vs-limit-order-vs-stop-order#content",
        "SSR:/blogs/market-order-vs-limit-order-vs-stop-order"
      ],
      "translation": "<span data-i18n-slot=\"0\">トレーダーは現在の市場でエントリーすることを決定しており、最初にリトレースメントする必要はありません。</span>"
    },
    {
      "key": "t3ae18912441861c6",
      "english": "<span data-i18n-slot=\"0\">A market order matches that logic because the request is sent immediately.</span>",
      "kind": "html",
