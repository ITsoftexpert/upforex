      "kind": "html",
      "sources": [
        "CMS:blogs/copy-trading-and-social-trading-explained#content",
        "SSR:/blogs/copy-trading-and-social-trading-explained"
      ],
      "translation": "<span data-i18n-slot=\"0\">开始跟单交易需要多少钱？</span>"
    },
    {
      "key": "t02772b8489b8ddaa",
      "english": "<span data-i18n-slot=\"0\">What is a copy trading platform?</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/copy-trading-and-social-trading-explained#content",
        "SSR:/blogs/copy-trading-and-social-trading-explained"
      ],
