        "CMS:blogs/what-is-account-equity-in-trading#descriptionSnippet",
        "SSR:/blogs",
        "SSR:/blogs/metatrader-demo-account-forex-trading-guide",
        "SSR:/blogs/what-is-account-equity-in-trading",
        "SSR:/blogs/how-to-use-mt5-expert-advisors-guide",
        "SSR:/blogs/forex-trading",
        "SSR:/blogs/trump-tarrif"
      ],
      "translation": "瞭解賬戶淨值與餘額有何不同、浮動盈虧如何實時變化以及如何在 MT5 上清楚地閱讀這些數字。"
    },
