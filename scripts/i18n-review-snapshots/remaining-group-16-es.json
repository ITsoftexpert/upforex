    },
    {
      "key": "tafde055893157296",
      "english": "<span data-i18n-slot=\"0\">A position can therefore experience both a spread and slippage.</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-slippage-in-forex-and-cfd-trading#content",
        "SSR:/blogs/what-is-slippage-in-forex-and-cfd-trading"
      ],
      "translation": "<span data-i18n-slot=\"0\">Por lo tanto, una posición puede experimentar tanto un diferencial como un deslizamiento.</span>"
    },
    {
      "key": "t4b7e875badb0f767",
      "english": "<span data-i18n-slot=\"0\">Central-bank announcements</span>",
      "kind": "html",
      "sources": [
