    {
      "key": "tdfa2d2fff5aa3bdf",
      "english": "<span data-i18n-slot=\"0\">What Is the Forex Position Size Formula?</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/how-to-calculate-forex-position-size:-formula,-lot-size-&-risk-examples#content",
        "SSR:/blogs/how-to-calculate-forex-position-size-formula-lot-size-risk-examples"
      ],
      "translation": "<span data-i18n-slot=\"0\">外汇头寸规模公式是什么？</span>"
    },
    {
      "key": "t636496d9cd2b6e29",
      "english": "<span data-i18n-slot=\"0\">The forex position size formula connects the amount you are prepared to risk with the distance between your entry and stop loss.</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/how-to-calculate-forex-position-size:-formula,-lot-size-&-risk-examples#content",
        "SSR:/blogs/how-to-calculate-forex-position-size-formula-lot-size-risk-examples"
      ],
      "translation": "<span data-i18n-slot=\"0\">外汇头寸规模公式将您准备承担风险的金额与您的进场和止损之间的距离联系起来。</span>"
    },
    {
      "key": "tbb67431eff8cc836",
      "english": "<span data-i18n-slot=\"0\">Pip value</span><span data-i18n-slot=\"1\">: the monetary value of each pip for the relevant position unit.</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/how-to-calculate-forex-position-size:-formula,-lot-size-&-risk-examples#content",
        "SSR:/blogs/how-to-calculate-forex-position-size-formula-lot-size-risk-examples"
      ],
      "translation": "<span data-i18n-slot=\"0\">点值</span><span data-i18n-slot=\"1\">：相关头寸单位的每个点的货币价值。</span>"
    },
