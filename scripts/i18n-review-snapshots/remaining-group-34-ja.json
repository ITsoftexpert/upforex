        "SSR:/blogs/unlock-earning-opportunities-with-cfd-index-trading-in-uae"
      ],
      "translation": "<span data-i18n-slot=\"0\">取引できる人気の指数は次のとおりです。</span>"
    },
    {
      "key": "tc63753df6afa21a9",
      "english": "<span data-i18n-slot=\"0\">1. S&amp;P 500</span><span data-i18n-slot=\"1\"></span><span data-i18n-slot=\"2\">2. NASDAQ 100</span><span data-i18n-slot=\"3\"></span><span data-i18n-slot=\"4\">3. Dow Jones</span><span data-i18n-slot=\"5\"></span><span data-i18n-slot=\"6\">4. FTSE 100</span><span data-i18n-slot=\"7\"></span><span data-i18n-slot=\"8\">5. DAX 40</span>",
      "kind": "html",
