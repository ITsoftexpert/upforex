      ],
      "translation": "<span data-i18n-slot=\"0\">典型的なシーケンスは次のとおりです。</span>"
    },
    {
      "key": "t2f9f295c34a9581e",
      "english": "<span data-i18n-slot=\"0\">Select Buy Limit or Sell Limit.</span>",
