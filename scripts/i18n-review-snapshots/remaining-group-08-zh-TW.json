      ],
      "translation": "<span data-i18n-slot=\"0\">近似點值</span>"
    },
    {
      "key": "t803056b00fb32cee",
      "english": "<span data-i18n-slot=\"0\">1.00 Standard Lot</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
        "SSR:/blogs/what-is-lot-size-in-forex"
      ],
      "translation": "<span data-i18n-slot=\"0\">1.00 標準手</span>"
    },
    {
      "key": "ta78fc0005860f4f6",
      "english": "<span data-i18n-slot=\"0\">$10 per pip</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
        "SSR:/blogs/what-is-lot-size-in-forex"
      ],
      "translation": "<span data-i18n-slot=\"0\">每點 10 美元</span>"
    },
    {
      "key": "t745b9066d9ce3a56",
      "english": "<span data-i18n-slot=\"0\">0.10 Mini Lot</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
        "SSR:/blogs/what-is-lot-size-in-forex"
      ],
      "translation": "<span data-i18n-slot=\"0\">0.10 迷你手</span>"
    },
    {
      "key": "tc46048626feb79e6",
      "english": "<span data-i18n-slot=\"0\">$1 per pip</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
        "SSR:/blogs/what-is-lot-size-in-forex"
      ],
      "translation": "<span data-i18n-slot=\"0\">每點 1 美元</span>"
    },
    {
      "key": "t5c3952929f87ec28",
      "english": "<span data-i18n-slot=\"0\">$0.10 per pip</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
