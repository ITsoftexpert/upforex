    },
    {
      "key": "tf79731ddfbacbbc1",
      "english": "<span data-i18n-slot=\"0\">0.001 lot = 100 base-currency units, where nano-lot trading is supported</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
