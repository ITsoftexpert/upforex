    },
    {
      "key": "tc6ef1f7bd8a97e05",
      "english": "<span data-i18n-slot=\"0\">The monetary value of a pip is therefore larger on a standard lot than on smaller lot sizes.</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/what-is-lot-size-in-forex#content",
        "SSR:/blogs/what-is-lot-size-in-forex"
      ],
      "translation": "<span data-i18n-slot=\"0\">因此，標準手數的點值貨幣價值大於小手數的貨幣價值。</span>"
    },
    {
      "key": "t7bab6abdae39b72d",
      "english": "<span data-i18n-slot=\"0\">0.10 lot = 1 mini lot</span>",
      "kind": "html",
