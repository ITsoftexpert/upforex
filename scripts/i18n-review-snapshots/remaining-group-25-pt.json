    },
    {
      "key": "te2cc7e9b44bfd243",
      "english": "<span data-i18n-slot=\"0\">Assume a trader buys </span><span data-i18n-slot=\"1\">one standard lot of EUR/USD</span><span data-i18n-slot=\"2\">, where one pip is approximately </span><span data-i18n-slot=\"3\">$10</span><span data-i18n-slot=\"4\"> in a US-dollar account. The market midpoint does not move before closing.</span>",
      "kind": "html",
      "sources": [
        "CMS:blogs/ecn-vs-market-maker-broker-difference#content",
        "SSR:/blogs/ecn-vs-market-maker-broker-difference"
      ],
      "translation": "<span data-i18n-slot=\"0\">Suponha que um trader compre </span><span data-i18n-slot=\"1\">um lote padrão de EUR/USD</span><span data-i18n-slot=\"2\">, em que cada pip vale aproximadamente </span><span data-i18n-slot=\"3\">$10</span><span data-i18n-slot=\"4\"> em uma conta em dólares americanos. O preço médio entre bid e ask não muda antes do encerramento.</span>"
    },
