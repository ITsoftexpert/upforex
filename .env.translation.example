# Optional cloud generator configuration. The default i18n:plan and
# i18n:translate commands now run offline and do not read this file.
# No key, account or billing setup is needed for the selected offline workflow.
# Do not enable paid generation without a separate explicit cost approval.
# Restrict the key to Cloud Translation API. Do not put it in src/ or Angular environments.
GOOGLE_TRANSLATE_API_KEY=

# No paid requests are allowed unless an explicit character limit is supplied.
# Used only by the separate scripts/translate-native-catalogs.cjs cloud tool.
# Leave this at zero unless paid use is explicitly approved.
TRANSLATION_MAX_CHARACTERS=0
