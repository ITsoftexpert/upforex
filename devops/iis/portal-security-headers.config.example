<?xml version="1.0" encoding="utf-8"?>
<!-- Merge only the customHeaders section into the portal's existing web.config.
     Preserve its routing, authentication, CORS and application settings.
     Verify portal login, MFA, payment, upload and document flows before rollout. -->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Content-Security-Policy" />
        <remove name="X-Frame-Options" />
        <remove name="X-Content-Type-Options" />
        <remove name="Referrer-Policy" />
        <remove name="Strict-Transport-Security" />
        <add name="Content-Security-Policy" value="base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Host-only HSTS; deliberately omit includeSubDomains and preload.
             Browsers accept this header only over HTTPS. Keep HTTP -> HTTPS
             redirection configured on this IIS site. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
